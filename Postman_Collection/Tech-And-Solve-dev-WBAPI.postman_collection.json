				{
					"name": "Obtener el cliente creado",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"El código del response es exitoso\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"El cliente fue encontrado\", function() {\r",
									"    var client = pm.response.json();\r",
									"\r",
									"    var clientId = parseInt(pm.collectionVariables.get('clientId'));\r",
									"    \r",
									"    pm.expect(client).to.have.property('id');\r",
									"    pm.expect(client.id).to.eql(clientId);\r",
									"});\r",
									"\r",
									"pm.test(\"El cliente tiene las propiedades requeridas\", function() {\r",
									"    var client = pm.response.json();\r",
									"\r",
									"    pm.expect(client).to.have.property('name');\r",
									"    pm.expect(client).to.have.property('lastName');\r",
									"    pm.expect(client).to.have.property('email');\r",
									"    pm.expect(client).to.have.property('phoneNumber');\r",
									"    pm.expect(client).to.have.property('address');  \r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
