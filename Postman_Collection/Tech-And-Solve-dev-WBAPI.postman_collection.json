		{
			"name": "Clientes",
			"item": [
				{
					"name": "Crear nuevo cliente",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"El código del response es exitoso\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Retorna el identificador del cliente creado\", function () {\r",
									"    var id = parseInt(pm.response.text());\r",
									"\r",
									"    pm.expect(id).to.be.a('number');\r",
									"    pm.expect(id).to.be.above(0);\r",
									"\r",
									"    pm.collectionVariables.set(\"clientId\", id);\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
