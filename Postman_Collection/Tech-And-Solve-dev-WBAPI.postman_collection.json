				{
					"name": "Obtener todos los clientes",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"El código del response es exitoso\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"La respuesta es un array\", function() {\r",
									"    var jsonData = pm.response.json();\r",
									"\r",
									"    pm.expect(jsonData).to.be.an('array');\r",
									"});\r",
									"\r",
									"pm.test(\"Los clientes tienes las propiedades requeridas\", function() {\r",
									"    var jsonData = pm.response.json();\r",
									"\r",
									"    if(jsonData.length > 0) {\r",
									"        var firstClient = jsonData[0];\r",
									"\r",
									"        pm.expect(firstClient).to.have.property('id');\r",
									"        pm.expect(firstClient).to.have.property('name');\r",
									"        pm.expect(firstClient).to.have.property('lastName');\r",
									"        pm.expect(firstClient).to.have.property('email');\r",
									"        pm.expect(firstClient).to.have.property('phoneNumber');\r",
									"        pm.expect(firstClient).to.have.property('address');  \r",
									"    }\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
